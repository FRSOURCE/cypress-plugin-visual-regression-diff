# Non-secret production settings, passed to docker compose with --env-file.
# Secrets and per-deployment values are injected by .github/workflows/deploy-github-app.yml
# as step-level environment variables, which take precedence over this file.
ENV_SUFFIX=prod
PORT=3100
CACHE_TTL_HOURS=168
CACHE_MAX_BYTES=5368709120
IMAGE_URL_TTL_HOURS=336
LOG_LEVEL=info

# Provided by the workflow (repository variables / secrets):
# VERSION_TAG=?        image tag, main-<sha>
# APP_HOST=?           public host name, e.g. visual-regression.frsource.org
# APP_ID=?             GitHub App id
# PRIVATE_KEY=?        GitHub App private key (PEM, or base64 of the PEM)
# WEBHOOK_SECRET=?     GitHub App webhook secret
# IMAGE_URL_SECRET=?   random secret signing the image links (openssl rand -hex 32)
