{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "sequential-calls": true,
  "plugins": [
    "node-workspace"
  ],
  "prerelease-type": "beta",
  "separate-pull-requests": true,
  "packages": {
    "packages/cypress-plugin-visual-regression-diff": {
      "path": "packages/cypress-plugin-visual-regression-diff",
      "component": "@frsource/cypress-plugin-visual-regression-diff"
    },
    "packages/visual-regression-manifest": {
      "path": "packages/visual-regression-manifest",
      "component": "@pixsame/manifest",
      "versioning": "prerelease",
      "prerelease": true,
      "release-as": "1.0.0-beta.1"
    },
    "packages/playwright-visual-regression-diff": {
      "path": "packages/playwright-visual-regression-diff",
      "component": "@tozsame/playwright",
      "versioning": "prerelease",
      "prerelease": true,
      "release-as": "0.1.0-beta.1"
    }
  }
}
